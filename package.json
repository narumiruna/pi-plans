    "prepack": "npm run ci",
    "prepare": "husky"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@earendil-works/pi-ai": "^0.86.1",
    "@earendil-works/pi-coding-agent": "^0.86.1",
    "@types/node": "^26.0.0",
    "husky": "^9.1.7",
    "typebox": "^1.3.34",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
