{
  "name": "@narumitw/pi-plans",
  "version": "0.1.0",
  "description": "Manage durable plan documents in Pi.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "private": false,
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "plans",
    "planning",
    "coding-agent"
  ],
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narumiruna/pi-plans.git"
  },
  "scripts": {
